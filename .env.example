# --- AI provider ---
# "jev"        = Jev decisions model on OpenRouter (default when OPENROUTER_API_KEY is set, ~$0.00002/decision)
# "openrouter" = free OpenRouter chat models
# "gemini"     = Google Gemini free tier
AI_PROVIDER=

# OpenRouter key (used by both "jev" and "openrouter"). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# "auto" = pick from OpenRouter's current free models, or set one, e.g. a model id ending in ":free"
OPENROUTER_MODEL=auto

# Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Broker ---
# "local"  = built-in simulated paper account (no signup needed)
# "alpaca" = Alpaca free paper-trading account (https://app.alpaca.markets/paper/dashboard/overview)
BROKER=local
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Starting cash for the local paper account
STARTING_CASH=100000

# --- Bot settings ---
# How often the bot scans for a fresh IFVG and asks the AI (minutes). Stops/targets are checked every minute.
BOT_INTERVAL_MINUTES=5
# Candle size for IFVG detection: 300 (5m), 900 (15m), 3600 (1h), 21600 (6h), 86400 (1d)
CANDLE_GRANULARITY=900
# Ignore AI decisions below this confidence (0-1)
MIN_CONFIDENCE=0.6
# Max % of equity the bot may hold in BTC
MAX_POSITION_PCT=50
# Max % of equity used per single trade
MAX_TRADE_PCT=10
# Max new trades per UTC day (hard cap 10)
MAX_TRADES_PER_DAY=10
# The bot trades automatically by default; set to false to start it stopped
AUTO_START=true

# --- Storage ---
# Supabase (recommended, required on Vercel). Run supabase/schema.sql once in the Supabase SQL editor.
# URL: Project Settings -> Data API. Key: Project Settings -> API Keys -> secret key (sb_secret_...) or legacy service_role.
# Server-side only: never put the secret key in front-end code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Hosting on Vercel ---
# Alternative storage: Upstash Redis (UPSTASH_REDIS_REST_URL / _TOKEN also work). Supabase wins if both are set.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Protects GET/POST /api/cron (send it as "Authorization: Bearer <secret>")
CRON_SECRET=

PORT=3000
