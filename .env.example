# --- AI (Google Gemini, free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Broker ---
# "local"  = built-in simulated paper account (no signup needed)
# "alpaca" = Alpaca free paper-trading account (https://app.alpaca.markets/paper/dashboard/overview)
BROKER=local
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Starting cash for the local paper account
STARTING_CASH=100000

# --- Bot settings ---
# How often the bot asks the AI for a decision (minutes)
BOT_INTERVAL_MINUTES=15
# Candle size for analysis: 60 (1m), 300 (5m), 900 (15m), 3600 (1h), 21600 (6h), 86400 (1d)
CANDLE_GRANULARITY=3600
# Ignore AI decisions below this confidence (0-1)
MIN_CONFIDENCE=0.6
# Max % of equity the bot may hold in BTC
MAX_POSITION_PCT=50
# Max % of equity used per single trade
MAX_TRADE_PCT=10
# Start the bot automatically when the server starts
AUTO_START=false

PORT=3000
